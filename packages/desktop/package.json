{
  "name": "@auis/desktop",
  "productName": "Auis Design",
  "version": "0.1.0",
  "private": true,
  "description": "Auis for Mac: opens a project, runs its dev server and shows the product with Auis on top.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-timeout=60000 \"test/*.test.ts\"",
    "smoke": "node scripts/build.mjs && node --test --test-timeout=120000 test/smoke/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "material-symbols": "^0.49.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
