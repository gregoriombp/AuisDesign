{
  "name": "@auis/ui",
  "version": "0.1.0",
  "description": "The Review Bridge chrome — pins, comments, the drawer — with its own scoped styles, for any React 18+ app.",
  "type": "module",
  "license": "MIT",
  "author": "Gregório Pinheiro — Design Engineer UX/UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregoriombp/AuisDesign.git",
    "directory": "kit/ui"
  },
  "homepage": "https://github.com/gregoriombp/AuisDesign/tree/main/kit/ui#readme",
  "bugs": {
    "url": "https://github.com/gregoriombp/AuisDesign/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chrome.css": "./dist/styles/chrome.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepack": "node ../scripts/build.mjs ui"
  },
  "dependencies": {
    "@auis/core": "^0.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
