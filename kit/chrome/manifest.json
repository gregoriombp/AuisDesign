{
  "manifest_version": 3,
  "name": "AuisRewiew",
  "description": "Revise páginas com seleção, pins, desenhos, comentários e voz. Exporte para PDF, PNG ou para uma IA.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://novah.auis.design/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ativar AuisRewiew"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "library.html?settings=1",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Ativar ou recolher a revisão"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "icon48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
