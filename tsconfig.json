{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@auis/core": [
        "./kit/core/src/index.ts"
      ],
      "@auis/core/*": [
        "./kit/core/src/*"
      ],
      "@auis/server": [
        "./kit/server/src/index.ts"
      ],
      "@auis/server/*": [
        "./kit/server/src/*"
      ],
      "@auis/next": [
        "./kit/next/src/index.ts"
      ],
      "@auis/next/*": [
        "./kit/next/src/*"
      ],
      "@auis/ui": [
        "./kit/ui/src/index.ts"
      ],
      "@auis/ui/*": [
        "./kit/ui/src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "review-bridge",
    "flow-bridge",
    "kit/*/dist"
  ]
}
